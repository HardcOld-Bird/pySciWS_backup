# 期刊契约层：APS（PRL/PR）——内容资产（ADR 2026-11-17）。
# 尺寸契约 85/170mm（宽度由 export 层按 JOURNAL_WIDTHS 施加，不在 rcParams）；
# 字体 Arial 8pt 主链（回退 Helvetica → DejaVu Sans）；可编辑矢量：fonttype=42 /
# svg 文字保留 <text> 节点。叠加顺序：审美层（house / scienceplots）在前，本层最后覆盖。
#
# 契约层只写**与审美层冲突时必须赢**的键（字体链/字号/导出字体类型），其余从 house。

font.family : sans-serif
font.sans-serif : Arial, Helvetica, DejaVu Sans
font.size : 8
axes.titlesize : 8
axes.labelsize : 8
xtick.labelsize : 7
ytick.labelsize : 7
legend.fontsize : 7
figure.titlesize : 9
mathtext.default : it
mathtext.fontset : dejavusans
pdf.fonttype : 42
ps.fonttype : 42
svg.fonttype : none
