# pycache
__pycache__/

# dirs
/.idea/
/.venv/

# 研究资产树（data/research/）：.mph 模型体积大、storage 为可再生输出，均不入版本控制
# （理论笔记 / 参考资料等小文本仍按需跟踪）
/data/research/**/simulation/
/data/research/**/experiment/

# Build artifacts
*.egg-info/

# 凭据与环境变量（文献检索工具使用）
.env

# 文献数据区（data/skills/literature_research/）的缓存治理完全交由其目录内的
# .gitignore（cache/* + !cache/extracted/）——cache 下默认全部忽略，唯独
# cache/extracted/（MinerU 配额换来的转换全文 .md）纳入跟踪。此处不再重复排除，
# 否则整目录排除会使子目录的 !cache/extracted/ 再包含规则失效。
