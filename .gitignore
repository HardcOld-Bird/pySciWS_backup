# pycache
__pycache__/

# dirs
/.idea/
/.venv/

# 研究资产树（data/research/）：.mph 模型体积大、storage 为可再生输出，均不入版本控制
# （理论笔记 / 参考资料等小文本仍按需跟踪）
/data/research/**/simulation/
/data/research/**/experiment/
/data/research/**/storage/

# 图管线可再生中间产物与超大矢量交付物（eps/svg 可由 figures 管线重建；pdf/png 仍跟踪）
/data/research/**/figures/*/raw/
/data/research/**/figures/*/panels/
/data/research/**/figures/*/out/*.eps
/data/research/**/figures/*/out/*.svg
/data/research/**/figures/*/cache_*.npz

# harness 压测产物区（orch eval run 每次真派发都重新生成）：入库会把测量噪声
# 变成 git status 脏面，进而挡住下一次合并前检查（E2，backlog 20261011-233002-leader）。
/data/research/eval_scratch/

# Build artifacts
*.egg-info/

# 凭据与环境变量（文献检索工具使用）
.env

# 文献数据区（data/skills/literature_research/）的缓存治理完全交由其目录内的
# .gitignore（cache/* + !cache/extracted/）——cache 下默认全部忽略，唯独
# cache/extracted/（MinerU 配额换来的转换全文 .md）纳入跟踪。此处不再重复排除，
# 否则整目录排除会使子目录的 !cache/extracted/ 再包含规则失效。

# 编排体系机器产物不入库（orchestration/README.md §2 git 策略）：
# 台账流水为运行期数据；根 .qoder/skills/orchestration/ 是部署副本
#（真本在 orchestration/skills/orchestration/，orch sync 再生）。
/orchestration/state/ledger/
/.qoder/skills/orchestration/
/orchestration/state/backups/
# cp 备份（worktree merge 的 <name>.bak-<ts>）：本地面的历史副本，永不跨树、也不入库
/orchestration/state/*.bak-*
# drain 运行态：互斥锁（含 pid，纯运行态）、每次 drain 的审计日志/摘要、协作式
# 取消信号（drain-stop 写入；worker 消费后自删，中途死掉则留残）。永久审计在 git
# 提交 + backlog.json（每项 commit hash）+ ledger，故运行态文件不入库（避免污染
# git status 与误提交陈旧锁/信号）。采纳 devops 建议 20261010-081857 + 20261010-163347。
/orchestration/state/devops.lock
/orchestration/state/devops-runs/
/orchestration/state/devops.cancel
# bencher 测量 worker 运行态（README §5.5/E4，同一套 git 策略）：FIFO 队列本体、
# 互斥锁、run 日志与 .done、协作取消信号。永久审计在 git 提交 + ledger + A/B 判决文档，
# 队列只是「还没消化完的工作」，随跑随变，入库会让 main 工作区每跳必 dirty。
/orchestration/state/bencher/
/orchestration/state/bencher.lock
/orchestration/state/bencher-runs/
/orchestration/state/bencher.cancel
# inspector 巡检引擎运行态（README §6/E5a，同一套 git 策略）：巡检队列、发现台账、
# 迟滞闸当前态、晋升证据正文、互斥锁、run 日志与 .done、协作取消信号。发现要留下的
# 永久痕迹都已外溢到 backlog.json + preference-journal.jsonl + ledger（晋升面），
# findings.jsonl 本身是「本轮巡检的过程态」，入库会让 main 工作区每次自主巡检必 dirty。
/orchestration/state/inspector/
/orchestration/state/inspector.enabled
/orchestration/state/inspector.lock
/orchestration/state/inspector-runs/
/orchestration/state/inspector.cancel
# 基线捕获的物理归档（§13 待决 2 的 E4 定案）：manifest.json 入库（=「当时依赖什么」的
# 答案），pods/ 下的 gitignored 面副本不入库——它随时可由 git + 清单再生。
/orchestration/state/evals/baselines/*/pods/
# orch watch 的基线快照/心跳（backlog 20261010-orch-watch）：纯运行态观察面，
# 事件已随 orch status 补账清算，无审计价值
/orchestration/state/watch.json
# Tier A 自动立案的指纹去重台账（README §5.4，backlog 20261011-233001-leader）：
# 每次 status/approve 都可能改写，纯运行态记忆（「同指纹 24h 内不重复立案」）。
# 立案这件事本身记在 suggestions/ 与 backlog.json 里，审计价值在那两侧，故本文件不入库。
/orchestration/state/tier-a-filed.json
# 会话池运行态（backlog 20261010-registry-runtime-split）：registry.json 每派发一跳
# 就改写 sessions/hops/last_active/chars_offset——留在配置面会让 main 工作区必 dirty、
# 碰 registry 的 worktree 交付 merge 前被心跳 dirty 拦（163347/220711 同构阻塞）。迁到
# 本运行态文件（唯一落点 sessions-runtime.json）；registry.presplit.json 是首次迁移的
# 原文备份，同属运行态。永久审计在 registry 配置面 + backlog + ledger，故不入库。
/orchestration/state/sessions-runtime.json
/orchestration/state/registry.presplit.json
# 渠道回退事件流（用户裁决 2026-10-12 21:1x，backlog 20261012-211500-leader 规格 4b）：
# 每次降级一跳就可能追加一行，入库等于让 main 工作区每跳必 dirty（sessions-runtime
# 同构教训）。永久审计在 ledger 的 model 字段与 drain run 日志，本文件只是 mirror/
# orch status 概览项的过程态读数源。
/orchestration/state/channel-events.jsonl
# 路由峰谷判定的上次读数（路由 v3，backlog 20261013-093000-leader 规格 2）：每跳派发
# 都可能改写（跨进程比对才看得见切换），纯过程态。切换事件本身的永久审计在
# preference-journal.jsonl（kind=routing）与 drain run 日志。
/orchestration/state/routing-last.json

# 瞬时工作区（每个 worktree 是一次任务的全量检出，数万文件；用后即弃、可再生）
/.qoder/worktrees/
