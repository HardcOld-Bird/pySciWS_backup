# =============================================================================
#  pySciWS2 .gitignore
#  原则：跟踪“可重建骨架 + 清单 + 管理器 + 测试/评估定义”；忽略安装物、缓存、
#  凭据、会话、研究内容与一切使用痕迹。
# =============================================================================

# ---- Python / 缓存 ---------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/

# ---- 本地凭据 / 覆盖层 -----------------------------------------------------
.env
*.log
AGENTS.local.md
AGENTS.leader.local.md
AGENTS.meta.local.md

# ---- 项目内工具链 -----------------------------------------------------------
# 跟踪：toolchain.json、deps_manager/、deps/node/modules/{package.json,package-lock.json}
# 忽略：安装物、缓存、npm 包、项目 DSH 状态
/sub_root/deps_management/deps/git/
/sub_root/deps_management/deps/uv/
/sub_root/deps_management/deps/python/
/sub_root/deps_management/deps/node/runtime/
/sub_root/deps_management/deps/node/modules/node_modules/
/sub_root/deps_management/deps/node/modules/dsh_home/
/sub_root/deps_management/cache/

# ---- 测试 / 评估产物 -------------------------------------------------------
/sub_root/tests/artifacts/
/sub_root/evals/runs/
/sub_root/evals/reports/*.tmp
/sub_root/evals/overlays/*.tmp
# 本机 ACL 修复备份与回滚脚本（含本机绝对路径，换机器无意义）
/sub_root/evals/acl-recovery/

# ---- 研究内容（只留本地，永不入库） ---------------------------------------
# 源码与资产树都在 sub_root/ 下（Python 项目根 = sub_root）。
/sub_root/src/pysci/research/
/sub_root/scripts/research/
/sub_root/tests/research/
/sub_root/data/research/

# ---- data/ 白名单制 -------------------------------------------------------
# 只放行 data/skills 骨架面；其余本地保留
/sub_root/data/*
!/sub_root/data/skills/

# ---- 用户的inbox -----------------------------------------------------------
# 位置在 sub_root/ 顶层；只放行用户自管配置，其余本地保留
/sub_root/用户的inbox/*
!/sub_root/用户的inbox/pysci_settings.toml

# data/skills 的使用痕迹 / 本地缓存
/sub_root/data/skills/*/cache/
/sub_root/data/skills/*/runs/
/sub_root/data/skills/*/papers/
/sub_root/data/skills/*/bilingual/
/sub_root/data/skills/*/gallery/
/sub_root/data/skills/*/assets/
/sub_root/data/skills/*/projects/
/sub_root/data/skills/*/trash/
/sub_root/data/skills/*/ingest/
/sub_root/data/skills/*/reviews/
/sub_root/data/skills/*/shortlists/
/sub_root/data/skills/*/prompts/
/sub_root/data/skills/*/INDEX.md
/sub_root/data/skills/*/LEDGER.md
/sub_root/data/skills/*/manifest.jsonl
/sub_root/data/skills/*/README.md

# ---- IDE / OS --------------------------------------------------------------
.idea/
.vscode/
Thumbs.db
Desktop.ini
