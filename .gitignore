# pycache
__pycache__/

# dirs
/.idea/
/.venv/
/mphs/
/storage/

# 研究资产树（my_research/）：.mph 模型体积大、storage 为可再生输出，均不入版本控制
# （理论笔记 / 参考资料等小文本仍按需跟踪）
/my_research/**/mphs/
/my_research/**/storage/

# Build artifacts
*.egg-info/

# 凭据与环境变量（文献检索工具使用）
.env

# literature/ 数据区的缓存与 PDF（详见 literature/.gitignore）
/literature/cache/
